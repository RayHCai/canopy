.idea/
*.swp
.DS_Store
Thumbs.db
desktop.ini
*~

# Claude Code: share project settings, ignore per-user overrides.
.claude/settings.local.json

# Keep the shared VS Code settings, ignore per-user state.
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
