# Base URL of the review API (ADR 0017). Defaults to http://localhost:4000
# when unset, which is right for `docker compose up` + the API running
# locally. Point this at a deployed API's URL (e.g. https://api.example.com)
# for any other environment. Must be reachable from the browser, not just
# the server, since client components poll it directly -- so it needs the
# NEXT_PUBLIC_ prefix and gets baked into the client bundle at build time.
NEXT_PUBLIC_CANOPY_API_URL=http://localhost:4000
