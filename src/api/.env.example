# Copy to .env for local development (gitignored). See README.md for the
# full local stack walkthrough (docker compose + migrate + dev server).

DATABASE_URL=postgresql://canopy:canopy@localhost:5433/canopy

# S3-compatible object store. Leave S3_ENDPOINT unset to talk to real AWS S3
# instead of the local MinIO container.
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=canopy
S3_ACCESS_KEY_ID=canopy
S3_SECRET_ACCESS_KEY=canopy12345
S3_FORCE_PATH_STYLE=true

# Base URL this service is reachable at; used to build presigned-media links
# (GET /media/*) returned in API responses.
PUBLIC_URL=http://localhost:4000
PORT=4000

# Optional. Without it, PUT /reviews/:id/run falls back to deterministic
# blocker/summary text instead of calling Claude Haiku.
ANTHROPIC_API_KEY=
