{
  "name": "canopy-review-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Fastify + Prisma + S3 service that owns Canopy site-survey reviews (ADR 0017).",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "start": "tsx --env-file-if-exists=.env src/index.ts",
    "build": "tsc --noEmit",
    "db:migrate": "prisma migrate dev",
    "db:generate": "prisma generate",
    "test": "tsx --test"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.68.0",
    "@aws-sdk/client-s3": "^3.888.0",
    "@aws-sdk/s3-request-presigner": "^3.888.0",
    "@fastify/cors": "^11.1.0",
    "@prisma/client": "^6.16.0",
    "fastify": "^5.6.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "prisma": "^6.16.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
